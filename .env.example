# Provider config — copy this to .env and fill in your key
# Default: Ollama (local, no quota, offline)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=llama3.1:8b

